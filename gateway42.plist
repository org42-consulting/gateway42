<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Reference copy only. ./install.sh generates the authoritative LaunchAgent at
  ~/Library/LaunchAgents/com.gateway42.service.plist and is what you should
  normally use; it substitutes the real $HOME into the paths below.

  This file is here for manual installs and for diffing against what is
  actually loaded. Replace /Users/org42 with your own home directory before
  copying it into ~/Library/LaunchAgents — launchd does not expand ~ or $HOME.
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.gateway42.service</string>

    <key>ProgramArguments</key>
    <array>
        <string>/usr/local/bin/gateway42</string>
    </array>

    <key>RunAtLoad</key>
    <true/>

    <!-- Restart on a crash, but not after a clean stop (matches install.sh). -->
    <key>KeepAlive</key>
    <dict>
        <key>SuccessfulExit</key>
        <false/>
    </dict>

    <key>WorkingDirectory</key>
    <string>/Users/org42/.gateway42</string>

    <key>StandardOutPath</key>
    <string>/Users/org42/Library/Logs/gateway42/gateway.log</string>

    <key>StandardErrorPath</key>
    <string>/Users/org42/Library/Logs/gateway42/gateway.log</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
        <key>GW42_DB_PATH</key>
        <string>/Users/org42/.gateway42/db/gateway.db</string>
        <!-- Same file as stderr above; gateway42 detects that and writes once. -->
        <key>LOG_FILE</key>
        <string>/Users/org42/Library/Logs/gateway42/gateway.log</string>
    </dict>
</dict>
</plist>
